# --- Sanity ---------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-28

# --- Site -----------------------------------------------------------------
# Absolute origin, no trailing slash. Canonicals and hreflang are built from
# this, so leaving it unset ships localhost URLs to production.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Contact form (Resend) ------------------------------------------------
# Without all three, POST /api/contact returns 503 and sends nothing.
RESEND_API_KEY=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend, or sends are rejected.
CONTACT_FROM_EMAIL=
